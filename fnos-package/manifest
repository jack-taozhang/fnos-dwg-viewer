appname=fnos-dwg-viewer
version=1.0.10
display_name=CAD 看图
desc=在浏览器里直接打开 DWG / DXF 图纸，不用装 AutoCAD。<br>支持图层开关、测量、离线 HTML / PDF / SVG 导出，图纸不出内网。<br><b>在文件管理器里双击 .dwg / .dxf 即可直接打开。</b>
source=thirdparty
platform=all

maintainer=fnos-dwg-viewer
maintainer_url=https://github.com/mlightcad/cad-viewer

# 原生应用：使用飞牛系统自带的 Node.js v22 运行时，不需要 Docker
install_dep_apps=nodejs_v22

# 不声明 os_min_version：对系统版本的真实要求已经由 install_dep_apps 表达
# （nodejs_v22 运行时本身就是版本门槛）。写死一个版本号只会在系统版本号
# 格式不一致时误判为「不符合系统要求」而拒绝安装，收益为零。

desktop_uidir=ui

# ★ 刻意**不声明** desktop_applaunchname：本应用已经取消桌面图标，
#   只保留「文件管理器里双击 .dwg / .dxf → 打开方式」这一条入口。
#   声明了它会让应用中心在桌面上生成一个图标 —— 正是 1.0.9 要去掉的东西。
#   （⚠️ fnpack 仍会无条件写出 `desktop_applaunchname = `（空值），
#     所以校验要断言「值为空」，而不是断言「键不存在」。）

service_port=8020
checkport=true
ctl_stop=true

# 隐藏「授权目录」设置项（true = 不显示）。
# 本应用是 root 权限版（config/privilege 里 run-as: root），进程直接读全部
# 存储空间，授权目录这个概念已经没有意义 —— 摆在那里只会让人以为
# "还得先配目录才能打开图纸"。
disable_authorization_path=true

# 注意：manifest 是 INI 格式，值里不能出现 ; 或 #，会被当成注释截断
changelog=1.0.10 新增「裸模式」：带 ?bare=1 打开时由应用自己藏掉查看器外壳（ribbon/状态栏/命令行/竖排工具条），整页只剩图纸。这是思源「CAD 嵌入块」在**桌面客户端**下的解决方案 —— 桌面端宿主页在本机 127.0.0.1、iframe 在 NAS，必然跨源，宿主页注入样式会被浏览器静默丢弃（同源策略没有第三条路），以前只能改成只藏一半；现在由应用自己藏，同源与跨源都生效。同时把界面状态存储键按裸模式隔离（fnos.dwg.viewer.settings.bare），避免看不见开关的开关。1.0.9 取消桌面应用图标，只保留「在文件管理器里双击 .dwg / .dxf → 打开方式」这一条入口。同时去掉应用内的「图纸库」文件浏览抽屉与那个悬浮按钮 —— 本应用是纯粹的看图工具，双击哪张图纸就看哪张，不再在应用里复刻一个只读的文件管理器（想看别的图纸请用飞牛自己的文件管理，那才是这个职责的正主）。界面上不再有任何应用自带的顶栏或侧栏，整页就是图纸本身。入口改为 url 型：双击图纸时用浏览器新标签页打开，不再嵌在飞牛桌面窗口里（应用中心对第三方包只会建 iframe 型服务，装完由 cmd/fix-open-type 改库修正，appcenter 与 trim_sac 两个库都要改）。1.0.8 「本机存储」顶层改回 1.0.6 的样子：直接列出各个存储空间（显示成「存储空间 1」「存储空间 2」），不再在应用里替用户分「我的文件 / 团队文件 / 外接存储 / 远程挂载 / 应用文件」——飞牛自己的文件管理已经分好了，应用里再分一套只是多一层要维护的映射（卷怎么切、哪些算外接盘是系统的事）。相应地不再读 /proc/mounts 判断外接盘与远程挂载，FNOS_PROC_MOUNTS 开关与 /api/doctor 里的 mountsFile 字段一并移除；FNOS_VOL_ROOTS 保留（Docker 挂整盘 / 开发调试用）。1.0.7 起只剩 root 一种模式，装完什么都不用配：安装包统一是 root 权限版（进程直接读写全部存储空间，从文件管理器双击任意位置的 DWG/DXF 都能打开），「授权目录」「按需授权」两套机制整体删除，应用中心里不再出现访问权限设置项，界面上那两行运行模式提示也去掉了；应用中心与桌面图标的名字去掉「（root 权限版）」后缀，就叫 CAD 看图；左侧图纸库抽屉默认收起，双击图纸进来看到的只有图，想看别的图纸点图面左上角的「图纸库」。1.0.6 修复「装了 root 权限版，从文件管理器双击图纸仍然提示这个目录还没授权」：服务端改为按运行期真实身份（uid 为 0）判定并自动进入全盘模式，图纸库顶层列出各个存储空间，不再需要任何授权目录、也不需要 WebDAV。1.0.5 新增「按需授权」：接上飞牛官方网页 SDK（@trimjs/web-app），在应用里当场弹文件选择器把文件夹授权给本应用。1.0.4 修复「授权目录里有的子文件夹打得开、有的打不开」，内置权限体检 /api/doctor；WebDAV 数据源通用化；修复「改完设置应用变已停用」；「图纸库」悬浮按钮移到图面左上角。1.0.3 修复授权目录冒号拼接解析、中文文件名显示为百分号编码、按钮压住菜单栏。1.0.2 修复菜单不全与抽屉被裁掉。1.0.1 修复安装被拒：补齐 cmd 生命周期脚本。
