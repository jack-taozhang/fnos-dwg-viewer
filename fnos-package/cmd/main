#!/bin/bash
#
# fnOS 生命周期脚本（原生应用，不依赖 Docker）
#
# 要点：
#  · 用飞牛系统自带的 Node.js v22 运行时启动服务
#  · 安装包是 root 权限版（config/privilege 里 run-as: root），进程直接
#    读写全部存储空间 —— 没有"授权目录"这回事，不需要任何环境变量
#  · 用 PID 文件做状态判断，应用中心才能显示正确的运行状态
#
# 关于"应用莫名变成已停用"：
#   早先这里只写 `node index.mjs &`。脚本一退出，飞牛回收本次调用的进程组，
#   服务就跟着被带走了 —— 表现就是应用中心显示已停用、端口不通。
#   现在统一用 nohup + setsid + </dev/null 把它彻底脱离会话；
#   PID 也不再取 $!（setsid 会 fork，$! 可能是个立刻退出的壳），
#   改由服务端自己在 listen 成功后把真实 pid 写进 PID 文件。

export PATH=/var/apps/nodejs_v22/target/bin:$PATH

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_DIR="${TRIM_APPDEST}/server"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
  kill -0 "$1" 2>/dev/null
}

read_pid() {
  head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]'
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(read_pid)"
    if [ -n "$pid" ] && check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    return 0
  fi

  mkdir -p "$TRIM_PKGVAR"
  touch "$LOG_FILE"
  log_msg "Starting CAD viewer: port=${TRIM_SERVICE_PORT:-8020} user=$(id -un 2>/dev/null) uid=$(id -u 2>/dev/null)"

  cd "$APP_DIR" || {
    log_msg "应用目录不存在：$APP_DIR"
    echo "CAD 看图启动失败：应用目录不存在 $APP_DIR" > "$TRIM_TEMP_LOGFILE"
    return 1
  }

  export PORT="${TRIM_SERVICE_PORT:-8020}"
  # 让服务端 listen 成功后自己写 PID，比 $! 可靠
  export FNOS_PID_FILE="$PID_FILE"

  rm -f "$PID_FILE"

  if command -v setsid >/dev/null 2>&1; then
    nohup setsid node index.mjs >> "$LOG_FILE" 2>&1 < /dev/null &
  else
    nohup node index.mjs >> "$LOG_FILE" 2>&1 < /dev/null &
  fi
  disown 2>/dev/null || true

  # 等服务端把真实 pid 写出来；起不来就不会有文件
  local i=0
  while [ "$i" -lt 16 ]; do
    [ -s "$PID_FILE" ] && break
    sleep 0.5
    i=$((i + 1))
  done

  if status_app; then
    log_msg "Started, pid=$(read_pid)"
    return 0
  fi

  log_msg "启动失败，请查看日志：$LOG_FILE"
  echo "CAD 看图启动失败，请查看日志：$LOG_FILE" > "$TRIM_TEMP_LOGFILE"
  return 1
}

stop_app() {
  log_msg "Stopping CAD viewer..."
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi

  local pid
  pid="$(read_pid)"
  if [ -z "$pid" ] || ! check_process "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi

  kill -TERM "$pid" 2>> "$LOG_FILE" || true

  local count=0
  while check_process "$pid" && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done

  if check_process "$pid"; then
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi

  rm -f "$PID_FILE"
  return 0
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
