#!/bin/bash
#
# 用户在应用设置里点「保存」之后调用。这里负责把服务**重新拉起来**，
# 让新的设置立刻生效。
#
# 为什么必须显式重启：飞牛在应用设置变更时会先停掉应用（为了避免旧进程
# 还拿着旧的环境变量），而它自己不保证再启动。没有这个回调时，
# "改个设置 → 保存 → 应用变成已停用"就是这么来的。
#
# 幂等：先停（可能已经停了）、再起（起得来就返回 0）。

export PATH=/var/apps/nodejs_v22/target/bin:$PATH

PKGVAR="${TRIM_PKGVAR:-/tmp/${TRIM_APPNAME:-fnos-dwg-viewer}}"
LOG_FILE="${PKGVAR}/app.log"
PID_FILE="${PKGVAR}/app.pid"
APP_DIR="${TRIM_APPDEST}/server"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - [config_callback] $1" >> "$LOG_FILE"
}

check_process() {
  kill -0 "$1" 2>/dev/null
}

mkdir -p "$PKGVAR" 2>/dev/null
touch "$LOG_FILE" 2>/dev/null

# 先把「打开方式」入口修正回 url 型（并去掉桌面图标）。
# 放在重启之前：应用中心保存设置时可能重建过服务行，顺手纠正一次。
FIX="${TRIM_APPDEST}/cmd/fix-open-type"
[ -x "$FIX" ] && "$FIX" >> "$LOG_FILE" 2>&1

# 优先复用 cmd/main（保证启动方式只有一处定义）
MAIN="${TRIM_APPDEST}/cmd/main"
if [ -x "$MAIN" ]; then
  log_msg "设置已保存，交由 cmd/main 重启"
  "$MAIN" stop >> "$LOG_FILE" 2>&1
  if "$MAIN" start >> "$LOG_FILE" 2>&1; then
    log_msg "设置已生效，服务已重新启动"
    exit 0
  fi
  log_msg "重启失败，请看日志：$LOG_FILE"
  echo "CAD 看图：设置已保存，但应用启动失败，请查看日志 $LOG_FILE" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
  exit 1
fi

# 兜底：cmd/main 不在预期位置时，自己拉一次（与 main 的启动方式一致）
log_msg "未找到 $MAIN，使用内置兜底启动"

if [ -f "$PID_FILE" ]; then
  pid="$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
  if [ -n "$pid" ] && check_process "$pid"; then
    kill -TERM "$pid" 2>/dev/null
    count=0
    while check_process "$pid" && [ "$count" -lt 10 ]; do
      sleep 1
      count=$((count + 1))
    done
    check_process "$pid" && kill -KILL "$pid" 2>/dev/null
  fi
  rm -f "$PID_FILE"
fi

cd "$APP_DIR" || {
  log_msg "应用目录不存在：$APP_DIR"
  exit 1
}

rm -f "$PID_FILE"
export PORT="${TRIM_SERVICE_PORT:-8020}"
export FNOS_PID_FILE="$PID_FILE"

if command -v setsid >/dev/null 2>&1; then
  nohup setsid node index.mjs >> "$LOG_FILE" 2>&1 < /dev/null &
else
  nohup node index.mjs >> "$LOG_FILE" 2>&1 < /dev/null &
fi
disown 2>/dev/null || true

i=0
while [ "$i" -lt 16 ]; do
  [ -s "$PID_FILE" ] && break
  sleep 0.5
  i=$((i + 1))
done

if [ -s "$PID_FILE" ]; then
  log_msg "设置已生效，服务已重新启动，pid=$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  exit 0
fi

log_msg "重启失败，请查看日志：$LOG_FILE"
echo "CAD 看图：设置已保存，但应用启动失败，请查看日志 $LOG_FILE" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
exit 1
