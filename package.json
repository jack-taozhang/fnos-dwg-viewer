{
  "name": "fnos-dwg-viewer",
  "private": true,
  "version": "1.7.5",
  "type": "module",
  "description": "fnOS（飞牛私有云）上的 DWG/DXF 在线看图器 —— 基于 @mlightcad/cad-viewer 1.7.5",
  "scripts": {
    "workers": "node scripts/copy-workers.mjs",
    "predev": "npm run workers",
    "dev": "vite",
    "prebuild": "npm run workers",
    "build": "vite build",
    "icons": "python scripts/make-icons.py",
    "fpk": "node scripts/build-fpk.mjs",
    "e2e": "node scripts/e2e-local.mjs",
    "e2e:all": "node scripts/e2e-allmode.mjs",
    "smoke": "node scripts/smoke-browser.mjs",
    "check:bare": "node scripts/check-bare.mjs",
    "test:dxf": "node scripts/test-dxf-legacy.mjs",
    "test:path": "node scripts/test-path-utils.mjs",
    "test": "npm run test:path && npm run test:dxf",
    "start": "node server/index.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@mlightcad/cad-agent-plugin": "1.7.5",
    "@mlightcad/cad-html-plugin": "1.7.5",
    "@mlightcad/cad-pdf-plugin": "1.7.5",
    "@mlightcad/cad-simple-viewer": "1.7.5",
    "@mlightcad/cad-svg-plugin": "1.7.5",
    "@mlightcad/cad-viewer": "1.7.5",
    "@mlightcad/data-model": "^1.15.3",
    "@mlightcad/libredwg-converter": "^3.15.2",
    "@mlightcad/pdf-renderer": "1.7.5",
    "@mlightcad/three-renderer": "1.7.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueuse/core": "^11.3.0",
    "element-plus": "^2.12.0",
    "lodash-es": "4.17.21",
    "three": "^0.172.0",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.4"
  }
}
